# AS-LAB - konfiguracja Apache dla lh.pl (shared hosting)
# Cache, kompresja, HTTPS, security headers, friendly URLs

# ============================================================
# HTTPS redirect (włącz po wgraniu SSL)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Redirect www → non-www (kanoniczna wersja)
  RewriteCond %{HTTP_HOST} ^www\.as-lab\.pl$ [NC]
  RewriteRule ^(.*)$ https://as-lab.pl/$1 [R=301,L]

  # Trailing slash dla katalogów (Astro generuje z trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+|/)$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Stare URL z WordPressa → przekierowanie do nowej struktury
  # (dopisz tu konkretne stare URL jeśli były inne)
  # RewriteRule ^stary-url/?$ /nowy-url/ [R=301,L]

  # Wycofana sekcja /regiony/ → serwis (obszar dostaw)
  RewriteRule ^regiony(/.*)?$ /serwis-maszyn/ [R=301,L]
</IfModule>

# ============================================================
# Custom error pages
# ============================================================
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html

# ============================================================
# Kompresja (Gzip / Brotli)
# ============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf application/font-woff application/font-woff2
</IfModule>

# ============================================================
# Cache headers (Expires)
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML krótko - aby aktualizacje były widoczne
  ExpiresByType text/html "access plus 5 minutes"

  # Sitemap / RSS / robots - codziennie
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/rss+xml "access plus 1 day"

  # Assety statyczne z hashami - rok
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonty - rok
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control header (uzupełnienie Expires)
<IfModule mod_headers.c>
  # Immutable dla assetów z hashem w nazwie
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML - musi rewalidować
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # ============================================================
  # Security headers
  # ============================================================
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Usunięcie wycieku wersji
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ============================================================
# MIME types (na wypadek gdyby Apache nie znał)
# ============================================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/font-woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
</IfModule>

# ============================================================
# Blokada dostępu do plików konfiguracyjnych
# ============================================================
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "(README\.md|package(-lock)?\.json|astro\.config\.mjs|tsconfig\.json|env\.example)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Wyłączenie listingu katalogów
Options -Indexes

# ============================================================
# Keep-Alive
# ============================================================
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
