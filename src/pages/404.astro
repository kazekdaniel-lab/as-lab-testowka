---
import BaseLayout from '../layouts/BaseLayout.astro';
import { productLinks } from '../lib/nav';

const title = 'Strona nie została znaleziona';
const description = 'Wybrana podstrona nie istnieje. Wróć do strony głównej lub przejdź do oferty AS‑LAB.';
---
<BaseLayout {title} {description} noindex>
  <section class="container-narrow py-24 lg:py-32 text-center">
    <div class="inline-flex items-center gap-2 mb-6">
      <span class="w-1 h-1 rounded-full bg-[var(--color-amber)]"></span>
      <span class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--color-amber)]">Błąd 404</span>
    </div>

    <h1 class="mb-6">
      Tej strony <span class="text-gradient-amber">tu nie ma</span>
    </h1>

    <p class="text-lg text-[var(--color-text-muted)] max-w-xl mx-auto mb-10 leading-relaxed">
      Adres może być błędny lub strona została przeniesiona. Sprawdź naszą ofertę
      lub wróć do strony głównej.
    </p>

    <div class="flex flex-wrap gap-3 justify-center mb-16">
      <a href="/" class="btn btn-primary">
        Strona główna
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <a href="/kontakt/" class="btn btn-ghost">Skontaktuj się z nami</a>
    </div>

    <div class="card p-6 lg:p-8 text-left">
      <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-4">
        Przejdź do oferty
      </div>
      <div class="grid sm:grid-cols-2 gap-2">
        {productLinks.map((p) => (
          <a href={p.href} class="flex items-center justify-between gap-3 px-4 py-3 rounded-md hover:bg-[var(--color-surface-2)] text-sm text-[var(--color-text-muted)] hover:text-[var(--color-cyan)] transition-colors">
            <span>{p.label}</span>
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" class="opacity-50"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
