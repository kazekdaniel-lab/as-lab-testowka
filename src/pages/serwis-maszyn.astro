---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import warsztat from '../assets/products/serwis-warsztat.png';
import naprawa from '../assets/products/serwis-naprawa.png';

const title = 'Profesjonalny serwis kruszarek – naprawy i remonty | AS‑LAB';
const description = 'Oferujemy kompleksowy serwis kruszarek – remonty, przeglądy i naprawy dopasowane do Twoich potrzeb. Mobilnie u klienta lub stacjonarnie w Łazach.';

const breadcrumbs = [{ name: 'Serwis maszyn', href: '/serwis-maszyn/' }];

const regions = ['śląskie', 'dolnośląskie', 'lubuskie', 'małopolskie', 'cała Polska'];

const serviceFaq = [
  { q: 'Jaki jest czas reakcji serwisu?', a: 'Zgłoszenia serwisowe odbieramy do 24h. Na pilne naprawy w obrębie województw śląskiego, dolnośląskiego, lubuskiego i małopolskiego dojeżdżamy w ciągu 48-72h. Większe remonty planowane są z 1-3 tygodniowym wyprzedzeniem.' },
  { q: 'Czy serwisujecie kruszarki innych producentów?', a: 'Tak. Serwisujemy kruszarki i młyny laboratoryjne wszystkich marek - polskich i zagranicznych. Diagnostyka, wymiana części, regeneracja mechanizmów. Posiadamy własny warsztat z parkiem maszynowym.' },
  { q: 'Czy oferujecie umowy serwisowe long-term?', a: 'Tak. Dla klientów z kilkoma maszynami lub kluczowych dla utrzymania ruchu oferujemy umowy serwisowe - regularne przeglądy, priorytet w kolejce napraw, gwarantowany czas reakcji.' },
  { q: 'Skąd dojeżdżacie z serwisem mobilnym?', a: 'Bazujemy w Łazach k. Bochni (woj. małopolskie, ok. 50 km na wschód od Krakowa). Stąd dojeżdżamy na terenie całej Polski, ze szczególnym uwzględnieniem południa kraju (Małopolska, Śląsk, Dolny Śląsk).' },
];

const schema = [
  {
    '@type': ['Service', 'ProfessionalService'],
    '@id': 'https://as-lab.pl/serwis-maszyn/#service',
    name: 'Serwis maszyn laboratoryjnych i kruszarek',
    serviceType: 'Maintenance and repair of industrial machinery',
    category: 'Industrial equipment maintenance',
    provider: { '@id': 'https://as-lab.pl/#organization' },
    areaServed: [
      { '@type': 'Country', name: 'Polska' },
      ...regions.map((r) => ({
        '@type': 'AdministrativeArea',
        name: r === 'cała Polska' ? 'Polska' : `województwo ${r}`,
      })),
    ],
    serviceArea: {
      '@type': 'GeoCircle',
      geoMidpoint: { '@type': 'GeoCoordinates', latitude: 49.9900045, longitude: 20.513614 },
      geoRadius: 700000,
    },
    description,
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: '+48 500 515 610',
      serviceUrl: 'https://as-lab.pl/kontakt/',
      availableLanguage: ['pl', 'en'],
    },
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '16:00',
    },
    offers: {
      '@type': 'Offer',
      priceCurrency: 'PLN',
      availability: 'https://schema.org/InStock',
      areaServed: { '@type': 'Country', name: 'Polska' },
      businessFunction: 'https://schema.org/Maintain',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Zakres usług serwisowych',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Przeglądy okresowe kruszarek' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Naprawy gwarancyjne i pogwarancyjne' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Remonty stacjonarne w warsztacie' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Diagnostyka maszyn laboratoryjnych' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Wymiana części zamiennych' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Mobilny serwis u klienta' } },
      ],
    },
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://as-lab.pl/serwis-maszyn/#faq',
    mainEntity: serviceFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout {title} {description} {schema} {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <Hero
    eyebrow="Mobilnie i stacjonarnie"
    title="Serwis kruszarek"
    highlight="i naprawa urządzeń specjalistycznych"
    description="AS‑LAB oferuje kompleksowy serwis kruszarek na terenie całego kraju. Przeglądy, remonty, naprawy gwarancyjne i pogwarancyjne - bezpośrednio u Państwa lub w naszym warsztacie w Łazach."
    primaryCta={{ href: '/kontakt/', label: 'Zamów serwis' }}
    secondaryCta={{ href: 'tel:+48500515610', label: '+48 500 515 610' }}
  />

  <section class="container-page pt-12">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="aspect-[4/3] overflow-hidden rounded-lg bg-[var(--color-bg)]">
        <Image
          src={warsztat}
          alt="Warsztat serwisowy AS‑LAB w Łazach"
          widths={[600, 1000]}
          sizes="(min-width: 640px) 50vw, 100vw"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="aspect-[4/3] overflow-hidden rounded-lg bg-[var(--color-bg)]">
        <Image
          src={naprawa}
          alt="Naprawa kruszarki - serwis u klienta"
          widths={[600, 1000]}
          sizes="(min-width: 640px) 50vw, 100vw"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="container-page py-20">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 prose-dark">
        <h2>Serwis i naprawa kruszarek laboratoryjnych</h2>
        <p>
          Prawidłowa konserwacja i fachowa naprawa maszyn to podstawa ich bezpiecznego i bezawaryjnego
          działania. Choć dostęp do serwisu popularnych urządzeń czy pojazdów nie stanowi problemu,
          <strong>serwis kruszarek, maszyn górniczych czy przesiewaczy wymaga specjalistycznej wiedzy
          i doświadczenia</strong>.
        </p>
        <p>
          Dlatego tak ważne jest, aby serwis tych urządzeń realizowany był przez profesjonalistów.
          Tylko wtedy można mieć pewność szybkiego i skutecznego usunięcia awarii oraz przywrócenia
          maszyn do pełnej sprawności.
        </p>

        <h2>Wysoka jakość napraw</h2>
        <p>
          AS‑LAB zatrudnia pracowników, którzy posiadają wieloletnie doświadczenie i szeroką wiedzę
          w zakresie serwisu i naprawy kruszarek oraz innych urządzeń różnego typu. Naszym priorytetem
          jest <strong>trwałość, bezpieczeństwo i niezawodność</strong> serwisowanych maszyn.
        </p>

        <h2>Indywidualne podejście</h2>
        <p>
          Każde zlecenie traktujemy indywidualnie. Realizujemy zarówno naprawy gwarancyjne, jak i
          serwis pogwarancyjny kruszarek, w tym również urządzeń laboratoryjnych. Oferujemy pełen
          zakres usług konserwacyjnych - od diagnostyki po wymianę zużytych części.
        </p>
      </div>

      <aside class="card p-6 sticky top-24 h-fit">
        <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-amber)] mb-4">
          Obszar działania
        </div>
        <h3 class="text-lg font-semibold mb-4">Serwis na terenie</h3>
        <ul class="space-y-2.5 mb-6">
          {regions.map((r) => (
            <li class="flex items-center gap-2.5 text-sm text-[var(--color-text-muted)]">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 1C4 1 2 3 2 6c0 3.5 5 7 5 7s5-3.5 5-7c0-3-2-5-5-5z" stroke="var(--color-cyan)" stroke-width="1.5"/>
                <circle cx="7" cy="6" r="1.5" fill="var(--color-cyan)"/>
              </svg>
              {r === 'cała Polska' ? r : `woj. ${r}`}
            </li>
          ))}
        </ul>
        <div class="divider-line mb-6"></div>
        <p class="text-xs text-[var(--color-text-dim)] mb-4">
          Zakres prac: przeglądy okresowe, remonty kruszarek, wymiana części, diagnostyka,
          konserwacja, naprawy gwarancyjne i pogwarancyjne.
        </p>
        <a href="/kontakt/" class="btn btn-primary w-full text-sm">Umów serwis</a>
      </aside>
    </div>
  </section>

  <CTA
    title="Awaria nie czeka. My też nie."
    description="Zgłoś serwis online lub zadzwoń bezpośrednio - oddzwonimy w ciągu 24 godzin."
  />
</BaseLayout>
