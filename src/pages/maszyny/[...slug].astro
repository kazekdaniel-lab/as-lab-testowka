---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SpecsTable from '../../components/SpecsTable.astro';
import MachineCard from '../../components/MachineCard.astro';
import MachinePlaceholder from '../../components/MachinePlaceholder.astro';
import CTA from '../../components/CTA.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { categories, industries } from '../../lib/categories';

export async function getStaticPaths() {
  const machines = await getCollection('machines', ({ data }) => !data.draft);
  return machines.map((machine) => ({ params: { slug: machine.id }, props: { machine } }));
}

const { machine } = Astro.props;
const { Content } = await render(machine);
const data = machine.data;

const category = categories[data.category];

// Related machines (same category, exclude self)
const allMachines = await getCollection('machines', ({ data }) => !data.draft);
const related = allMachines
  .filter((m) => m.data.category === data.category && m.id !== machine.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const breadcrumbs = [
  { name: 'Katalog maszyn', href: '/maszyny/' },
  { name: category.label, href: category.path },
  { name: data.shortName ?? data.name, href: `/maszyny/${machine.id}/` },
];

const title = `${data.name}${data.model ? ' ' + data.model : ''} | AS‑LAB`;
const description = data.tagline;
const ogImage = `/og/${machine.id}.jpg`;

// Dynamic image
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.{JPG,jpg,jpeg,png,webp,avif}', { eager: true });
const imageEntry = data.image
  ? images[`/src/assets/products/${data.image}`]
  : undefined;

// FAQ specific per maszyna (dla AI/AEO - LLM-y łapią Q&A natywnie)
const machineFaq = [
  {
    q: `Jakie zastosowania ma ${data.shortName ?? data.name}?`,
    a: data.applications && data.applications.length > 0
      ? `${data.shortName ?? data.name} stosujemy w następujących zastosowaniach: ${data.applications.join(', ')}. Główne branże klienta to: ${(data.industries || []).join(', ')}.`
      : `${data.tagline} Branże klienta: ${(data.industries || []).join(', ')}.`,
  },
  {
    q: `Z jakimi normami zgodny jest ${data.shortName ?? data.name}?`,
    a: data.norms && data.norms.length > 0
      ? `${data.shortName ?? data.name} projektujemy zgodnie z normami: ${data.norms.join(', ')}. Z każdym urządzeniem dostarczamy pełną dokumentację techniczną.`
      : `${data.shortName ?? data.name} produkujemy zgodnie z aktualnymi normami branżowymi. Z każdym urządzeniem dostarczamy pełną dokumentację techniczną.`,
  },
  {
    q: `Jak długo trwa produkcja ${data.shortName ?? data.name}?`,
    a: `Standardowo proces produkcji ${data.shortName ?? data.name} trwa 4-10 tygodni od akceptacji wyceny: projekt CAD (3-10 dni), konstrukcja (1-3 tyg.), produkcja i montaż (2-5 tyg.), wdrożenie u klienta (1-3 dni). Niektóre modele dostępne szybciej.`,
  },
  {
    q: `Czy można skonfigurować ${data.shortName ?? data.name} pod indywidualne potrzeby?`,
    a: `Tak. Każde urządzenie konfigurujemy pod specyfikę klienta - typ materiału, wymagana frakcja wyjściowa, warunki pracy. Konsultacja techniczna w 24h, wycena 2-5 dni roboczych. Skontaktuj się z nami przez formularz lub telefonicznie: +48 500 515 610.`,
  },
];

const schema = [
  {
    '@type': 'Product',
    '@id': `https://as-lab.pl/maszyny/${machine.id}/#product`,
    name: data.name,
    description: data.description,
    brand: { '@id': 'https://as-lab.pl/#organization' },
    manufacturer: { '@id': 'https://as-lab.pl/#organization' },
    category: category.longLabel,
    ...(data.model && { model: data.model, mpn: data.model, sku: data.model }),
    image: `https://as-lab.pl/og/${machine.id}.jpg`,
    additionalProperty: data.specs.map((s) => ({
      '@type': 'PropertyValue',
      name: s.label,
      value: s.value,
    })),
    audience: (data.industries || []).map((ind) => ({
      '@type': 'BusinessAudience',
      audienceType: ind,
    })),
    isRelatedTo: related.map((r) => ({
      '@type': 'Product',
      name: r.data.name,
      url: `https://as-lab.pl/maszyny/${r.id}/`,
    })),
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      priceCurrency: 'PLN',
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'PLN',
        valueAddedTaxIncluded: false,
      },
      seller: { '@id': 'https://as-lab.pl/#organization' },
      url: `https://as-lab.pl/maszyny/${machine.id}/`,
      areaServed: { '@type': 'Country', name: 'Polska' },
      businessFunction: 'https://schema.org/Sell',
    },
  },
  {
    '@type': 'FAQPage',
    '@id': `https://as-lab.pl/maszyny/${machine.id}/#faq`,
    mainEntity: machineFaq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout {title} {description} {schema} {breadcrumbs} image={ogImage}>
  <Breadcrumbs items={breadcrumbs} />

  <section class="container-page pt-8 pb-12">
    <div class="grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-3">
        <div class="eyebrow mb-4">{category.label}{data.model && <> · <span class="font-mono">{data.model}</span></>}</div>
        <h1 class="mb-6">{data.name}</h1>
        <p class="text-xl text-[var(--color-text-muted)] leading-relaxed mb-8">
          {data.tagline}
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/kontakt/" class="btn btn-primary">
            Zapytaj o wycenę
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a href={category.path} class="btn btn-ghost">{category.label} - wszystkie</a>
        </div>

        {data.industries.length > 0 && (
          <div class="mt-8">
            <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
              Branże klienta
            </div>
            <div class="flex flex-wrap gap-2">
              {data.industries.map((indKey) => {
                const ind = industries[indKey as keyof typeof industries];
                return ind ? <span class="badge">{ind.shortLabel}</span> : null;
              })}
            </div>
          </div>
        )}

        {data.norms.length > 0 && (
          <div class="mt-6">
            <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
              Zgodność z normami
            </div>
            <div class="flex flex-wrap gap-2">
              {data.norms.map((n) => (
                <span class="badge badge-bordo font-mono">{n}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="lg:col-span-2">
        <div class="aspect-[4/5] lg:aspect-square overflow-hidden rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)]">
          {imageEntry ? (
            <Image
              src={imageEntry.default}
              alt={data.imageAlt ?? data.name}
              widths={[400, 600, 900]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <MachinePlaceholder name={data.name} category={category.label} />
          )}
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="container-page py-16">
    <div class="grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 prose-dark">
        <Content />
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 h-fit">
        {data.specs.length > 0 && (
          <SpecsTable
            title="Specyfikacja techniczna"
            specs={data.specs}
          />
        )}

        <div class="card p-6">
          <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
            Zamówienie / wycena
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mb-4 leading-relaxed">
            Każde urządzenie konfigurujemy pod specyfikę klienta. Bezpłatna wycena w 24h.
          </p>
          <a href="/kontakt/" class="btn btn-primary w-full">Zapytaj o konfigurację</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid lg:grid-cols-3 gap-10">
      <div>
        <div class="eyebrow mb-3">FAQ</div>
        <h2>Pytania o {data.shortName ?? data.name}</h2>
        <p class="mt-3 text-[var(--color-text-muted)] text-sm">
          Najczęstsze pytania klientów o ten model. Nie ma Twojego pytania?
          <a href="/kontakt/" class="text-[var(--color-peach)] underline">Napisz do nas</a>.
        </p>
      </div>
      <div class="lg:col-span-2 space-y-3">
        {machineFaq.map((f, i) => (
          <details class="card group" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
              <span class="font-semibold text-[var(--color-text)] group-hover:text-[var(--color-peach)] transition-colors">{f.q}</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="flex-shrink-0 transition-transform group-open:rotate-180">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="px-5 pb-5 -mt-1">
              <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="container-page py-16">
      <div class="mb-8">
        <div class="eyebrow mb-3">Powiązane modele</div>
        <h2>Inne urządzenia w kategorii „{category.label}"</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {related.map((m) => <MachineCard machine={m} />)}
      </div>
    </section>
  )}

  <CTA
    title={`Zainteresowany urządzeniem ${data.shortName ?? data.name}?`}
    description="Skonfigurujemy urządzenie pod Państwa typ materiału, wymaganą frakcję wyjściową i warunki pracy. Wycena w ciągu 24h."
  />
</BaseLayout>
