---
interface Props {
  title?: string;
  specs: { label: string; value: string }[];
}
const { title, specs } = Astro.props;
---
<div class="card overflow-hidden">
  {title && (
    <div class="px-6 py-4 border-b border-[var(--color-border)] flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-amber)]"></span>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-text)]">{title}</h3>
    </div>
  )}
  <table class="w-full">
    <tbody>
      {specs.map((s, i) => (
        <tr class={i % 2 === 0 ? 'bg-[var(--color-surface)]' : 'bg-[var(--color-surface-2)]'}>
          <td class="px-6 py-3 text-sm text-[var(--color-text-muted)] w-1/2 border-b border-[var(--color-border)]">
            {s.label}
          </td>
          <td class="px-6 py-3 text-sm font-mono text-[var(--color-text)] border-b border-[var(--color-border)]">
            {s.value}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
