---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import MachineCard from '../components/MachineCard.astro';
import { getCollection } from 'astro:content';

const title = 'Kruszarki i młynki laboratoryjne | Urządzenia AS‑LAB';
const description = 'Pełna oferta kruszarek i młynków laboratoryjnych AS‑LAB: kruszarki szczękowe ZKS, walcowe LKW, młotkowe KM, młynki wibracyjne MW, planetarne MP oraz młynek odsiewający.';

const breadcrumbs = [{ name: 'Produkty', href: '/#oferta' }, { name: 'Kruszarki i młynki', href: '/kruszarki-i-mlynki-laboratoryjne/' }];

// Wszystkie maszyny tej kategorii, prosto z kolekcji (nie ręcznie).
const all = (await getCollection('machines', ({ data }) => !data.draft))
  .filter((m) => m.data.category === 'kruszarki-mlynki')
  .sort((a, b) => a.data.order - b.data.order);

// Grupowanie po typie - każda maszyna trafia do pierwszej pasującej grupy.
const groupDefs = [
  { label: 'Kruszarki szczękowe', match: (s) => s.includes('szczekowa') },
  { label: 'Kruszarki walcowe', match: (s) => s.includes('walcowa') },
  { label: 'Kruszarki młotkowe', match: (s) => s.includes('mlotkowa') },
  { label: 'Kruszarki stożkowe', match: (s) => s.includes('stozkowa') },
  { label: 'Młynki i pozostałe', match: () => true },
];
const groups = groupDefs.map((g) => ({ label: g.label, items: [] }));
const seen = new Set();
for (let i = 0; i < groupDefs.length; i++) {
  for (const m of all) {
    if (seen.has(m.id)) continue;
    if (groupDefs[i].match(m.id)) { groups[i].items.push(m); seen.add(m.id); }
  }
}
const shownGroups = groups.filter((g) => g.items.length > 0);

const schema = {
  '@type': 'ProductGroup',
  name: 'Kruszarki i młynki laboratoryjne',
  description,
  brand: { '@id': 'https://as-lab.pl/#organization' },
};
---
<BaseLayout {title} {description} {schema} {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <Hero
    eyebrow="Wstępne rozdrabnianie i mielenie próbek"
    title="Kruszarki i młynki"
    highlight="laboratoryjne"
    description="Projektujemy i produkujemy pełną gamę urządzeń do rozdrabniania: kruszarki szczękowe, walcowe i młotkowe oraz młynki wibracyjne, planetarne i odsiewające. Każdy model dobieramy pod rodzaj materiału i wymaganą frakcję wyjściową."
    primaryCta={{ href: '/kontakt/', label: 'Zapytaj o ofertę' }}
    secondaryCta={{ href: '#produkty', label: 'Zobacz modele' }}
  />

  <section class="container-page py-16 lg:py-20">
    <div class="prose-dark max-w-3xl">
      <p>
        Kruszarki i młynki laboratoryjne to precyzyjne narzędzia wykorzystywane w badaniach naukowych
        oraz przemyśle wydobywczym, energetycznym, chemicznym i spożywczym. Ich zadaniem jest
        przygotowanie reprezentatywnej, jednorodnej próbki do dalszych analiz lub odzysku surowców.
      </p>
      <p>
        Rozdrabnianie może opierać się na różnych mechanizmach - <strong>szczękowym, walcowym,
        udarowym, wibracyjnym</strong>. Dobór urządzenia zależy od twardości materiału, wielkości
        nadawy i wymaganego uziarnienia produktu. Poniżej pełna lista modeli w tej kategorii.
      </p>
    </div>
  </section>

  <section id="produkty" class="container-page pb-16 scroll-mt-20">
    {shownGroups.map((g) => (
      <div class="mb-14 last:mb-0">
        <div class="flex items-baseline gap-3 mb-6">
          <h2 class="text-2xl">{g.label}</h2>
          <span class="text-sm font-mono text-[var(--color-text-dim)]">{g.items.length}</span>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {g.items.map((m) => <MachineCard machine={m} />)}
        </div>
      </div>
    ))}
  </section>

  <CTA
    title="Postaw na profesjonalizm"
    description="Dobierzemy urządzenie pod Państwa typ materiału i wymaganą frakcję wyjściową. Możliwa demonstracja u klienta."
  />
</BaseLayout>
