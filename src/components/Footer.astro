---
import { productLinks, siteConfig } from '../lib/nav';
const year = new Date().getFullYear();
---
<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] mt-32">
  <div class="container-page py-16">
    <div class="grid lg:grid-cols-4 gap-12">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-8 h-8 rounded-md bg-gradient-to-br from-[var(--color-amber)] to-[var(--color-amber-dim)] flex items-center justify-center font-mono text-sm font-bold text-[var(--color-bg)]">
            AS
          </div>
          <span class="font-semibold text-lg">{siteConfig.name}</span>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] max-w-md leading-relaxed">
          Producent profesjonalnego sprzętu laboratoryjnego dla kopalń, laboratoriów i przemysłu.
          Kruszarki, młyny, sita, wstrząsarki oraz nietypowe rozwiązania na zamówienie.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {siteConfig.serviceRegions.map((r) => (
            <span class="badge text-[10px]">{r === 'cała Polska' ? r : `woj. ${r}`}</span>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-dim)] mb-4">Produkty</h4>
        <ul class="space-y-2 text-sm">
          {productLinks.slice(0, 6).map((p) => (
            <li>
              <a href={p.href} class="text-[var(--color-text-muted)] hover:text-[var(--color-cyan)] transition-colors">{p.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-dim)] mb-4">Kontakt</h4>
        <address class="text-sm not-italic space-y-2 text-[var(--color-text-muted)]">
          <div class="text-[var(--color-text)]">{siteConfig.legalName}</div>
          <div>{siteConfig.address.street}<br />{siteConfig.address.postalCode} {siteConfig.address.locality}</div>
          <div>
            <a href={`tel:${siteConfig.phoneClean}`} class="font-mono text-[var(--color-amber)] hover:text-[var(--color-amber-hover)]">
              {siteConfig.phone}
            </a>
          </div>
          <div>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--color-cyan)] break-all">
              {siteConfig.email}
            </a>
          </div>
          <div class="pt-2 font-mono text-xs text-[var(--color-text-dim)] space-y-0.5">
            <div>NIP: {siteConfig.nip}</div>
            <div>REGON: {siteConfig.regon}</div>
            <div>KRS: {siteConfig.krs}</div>
          </div>
        </address>
      </div>
    </div>

    <div class="divider-line my-10"></div>

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-xs text-[var(--color-text-dim)]">
      <div>© {year} {siteConfig.legalName}. Wszystkie prawa zastrzeżone.</div>
      <div class="flex gap-6">
        <a href="/polityka-prywatnosci/" class="hover:text-[var(--color-text-muted)]">Polityka prywatności</a>
        <a href="/regulamin/" class="hover:text-[var(--color-text-muted)]">Regulamin</a>
        <a href="/blog/" class="hover:text-[var(--color-text-muted)]">Blog</a>
      </div>
    </div>
  </div>
</footer>
