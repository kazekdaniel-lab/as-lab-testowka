---
import { mainNav, megaMenuColumns, megaMenuPreviews, siteConfig } from '../lib/nav';

const defaultPreviewKey = 'katalog';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---
<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[rgba(10,7,7,0.85)] backdrop-blur-xl">
  <div class="container-wide flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2.5 text-[var(--color-text)] hover:opacity-80 transition-opacity" aria-label="AS‑LAB strona główna">
      <div class="w-8 h-8 rounded-md bg-gradient-to-br from-[var(--color-bordo-hover)] to-[var(--color-bordo-deep)] flex items-center justify-center font-mono text-sm font-bold text-[#F8EDED]">
        AS
      </div>
      <div class="flex flex-col leading-tight">
        <span class="font-semibold tracking-tight">{siteConfig.name}</span>
        <span class="text-[10px] text-[var(--color-text-dim)] uppercase tracking-wider">Polski producent maszyn</span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-0.5" aria-label="Główna nawigacja">
      {mainNav.map((item) => (
        item.mega ? (
          <div class="relative group">
            <button
              type="button"
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors hover:text-[var(--color-peach)] hover:bg-[var(--color-surface)] flex items-center gap-1 ${isActive('/maszyny/') ? 'text-[var(--color-peach)]' : 'text-[var(--color-text-muted)]'}`}
              aria-expanded="false"
              aria-haspopup="true"
            >
              {item.label}
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform group-hover:rotate-180">
                <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[960px] card p-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all overflow-hidden mega-menu" data-mega-menu>
              <div class="grid grid-cols-[1.1fr_1fr]">
                <div class="p-6 border-r border-[var(--color-border)]">
                  <div class="grid grid-cols-2 gap-5">
                    {megaMenuColumns.map((col) => (
                      <div>
                        <div class="text-[10px] font-mono uppercase tracking-[0.15em] text-[var(--color-text-dim)] mb-3 pb-2 border-b border-[var(--color-border)]">
                          {col.heading}
                        </div>
                        <ul class="space-y-0.5">
                          {col.links.map((link) => (
                            <li>
                              <a
                                href={link.href}
                                data-preview-key={link.key}
                                class={`mega-link block px-3 py-2 rounded-md text-sm transition-all hover:bg-[var(--color-surface-2)] hover:text-[var(--color-peach)] hover:translate-x-0.5 ${isActive(link.href) ? 'text-[var(--color-peach)] bg-[var(--color-surface-2)]' : 'text-[var(--color-text-muted)]'}`}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="bg-[var(--color-surface-2)] relative overflow-hidden">
                  <div class="absolute inset-0 grid-bg-bordo opacity-50"></div>
                  <div class="relative p-6 h-full flex flex-col">
                    {Object.entries(megaMenuPreviews).map(([key, prev]) => (
                      <div
                        data-preview-content={key}
                        class={`mega-preview ${key === defaultPreviewKey ? '' : 'hidden'} flex flex-col h-full`}
                      >
                        <div class="text-[10px] font-mono uppercase tracking-[0.2em] text-[var(--color-peach)] mb-3 flex items-center gap-2">
                          <span class="w-1 h-1 rounded-full bg-[var(--color-bordo)]"></span>
                          Podgląd kategorii
                        </div>
                        <h3 class="text-lg font-semibold text-[var(--color-text)] mb-3 leading-tight">
                          {prev.title}
                        </h3>
                        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
                          {prev.description}
                        </p>
                        <ul class="space-y-1.5 mb-5 flex-1">
                          {prev.bullets.map((b) => (
                            <li class="flex items-start gap-2 text-xs text-[var(--color-text-muted)]">
                              <span class="text-[var(--color-bordo)] mt-0.5">›</span>
                              <span>{b}</span>
                            </li>
                          ))}
                        </ul>
                        <a href={prev.cta.href} class="inline-flex items-center justify-between gap-2 mt-auto px-4 py-2.5 rounded-md bg-[var(--color-bordo)] hover:bg-[var(--color-bordo-hover)] text-[#F8EDED] text-sm font-medium transition-colors">
                          {prev.cta.label}
                          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </a>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <a
                href="/maszyny/"
                class="group/cta block border-t border-[var(--color-border)] bg-gradient-to-r from-[var(--color-bordo-deep)]/30 via-[var(--color-surface)] to-[var(--color-bordo-deep)]/30 hover:from-[var(--color-bordo-deep)]/50 hover:to-[var(--color-bordo-deep)]/50 transition-colors"
              >
                <div class="px-6 py-4 flex items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-md bg-[var(--color-bordo)] flex items-center justify-center flex-shrink-0">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F8EDED" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"/>
                        <rect x="14" y="3" width="7" height="7" rx="1"/>
                        <rect x="3" y="14" width="7" height="7" rx="1"/>
                        <rect x="14" y="14" width="7" height="7" rx="1"/>
                      </svg>
                    </div>
                    <div>
                      <div class="text-sm font-semibold text-[var(--color-text)] leading-tight">
                        Przejdź do pełnego katalogu
                      </div>
                      <div class="text-xs text-[var(--color-text-muted)] font-mono mt-0.5">
                        25+ maszyn · 8 kategorii · filtry
                      </div>
                    </div>
                  </div>
                  <div class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-peach)] group-hover/cta:text-[var(--color-peach-hover)] group-hover/cta:gap-2.5 transition-all">
                    Otwórz katalog
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </div>
                </div>
              </a>
            </div>
          </div>
        ) : item.dropdown ? (
          <div class="relative group">
            <button
              type="button"
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors hover:text-[var(--color-peach)] hover:bg-[var(--color-surface)] flex items-center gap-1 ${item.dropdown.some(d => isActive(d.href)) ? 'text-[var(--color-peach)]' : 'text-[var(--color-text-muted)]'}`}
            >
              {item.label}
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform group-hover:rotate-180">
                <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="absolute top-full right-0 mt-1 w-56 card p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
              {item.dropdown.map((child) => (
                <a
                  href={child.href}
                  class={`block px-3 py-2 rounded-md text-sm transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-peach)] ${isActive(child.href) ? 'text-[var(--color-peach)] bg-[var(--color-surface-2)]' : 'text-[var(--color-text-muted)]'}`}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors hover:text-[var(--color-peach)] hover:bg-[var(--color-surface)] ${isActive(item.href) ? 'text-[var(--color-peach)]' : 'text-[var(--color-text-muted)]'}`}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <a href={`tel:${siteConfig.phoneClean}`} class="font-mono text-sm text-[var(--color-text-muted)] hover:text-[var(--color-peach)] transition-colors">
        {siteConfig.phone}
      </a>
      <a href="/kontakt/" class="btn btn-primary text-sm">
        Wycena
      </a>
    </div>

    <button
      id="mobile-menu-btn"
      type="button"
      class="lg:hidden p-2 text-[var(--color-text-muted)] hover:text-[var(--color-text)]"
      aria-label="Otwórz menu"
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <div class="container-page py-4 space-y-1">
      <a href="/maszyny/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] hover:bg-[var(--color-surface)] rounded-md">Katalog maszyn</a>
      {megaMenuColumns.map((col) => (
        <div class="ml-3 pl-3 border-l border-[var(--color-border)]">
          <div class="px-3 py-1 text-[10px] font-mono uppercase tracking-wider text-[var(--color-text-dim)]">{col.heading}</div>
          {col.links.map((link) => (
            <a href={link.href} class="block px-3 py-1.5 text-sm text-[var(--color-text-muted)] hover:text-[var(--color-peach)] rounded">
              {link.label}
            </a>
          ))}
        </div>
      ))}
      <div class="divider-line my-3"></div>
      <a href="/realizacje/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">Realizacje</a>
      <a href="/serwis-maszyn/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">Serwis</a>
      <a href="/o-firmie/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">O firmie</a>
      <a href="/proces-produkcji/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">Proces produkcji</a>
      <a href="/blog/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">Blog</a>
      <a href="/kontakt/" class="block px-3 py-2 text-sm font-medium text-[var(--color-text)] hover:text-[var(--color-peach)] rounded">Kontakt</a>
      <div class="pt-3 mt-3 border-t border-[var(--color-border)] space-y-2">
        <a href={`tel:${siteConfig.phoneClean}`} class="block px-3 py-2 font-mono text-sm text-[var(--color-peach)]">
          {siteConfig.phone}
        </a>
        <a href="/kontakt/" class="btn btn-primary w-full">Wycena</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });

  // Mega menu - dynamiczny preview na hover linków kategorii
  const initMegaMenu = () => {
    document.querySelectorAll<HTMLElement>('[data-mega-menu]').forEach((megaMenu) => {
      const links = megaMenu.querySelectorAll<HTMLAnchorElement>('[data-preview-key]');
      const previews = megaMenu.querySelectorAll<HTMLElement>('[data-preview-content]');
      const defaultKey = previews[0]?.dataset.previewContent;

      const showPreview = (key: string | undefined) => {
        previews.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.previewContent !== key);
        });
      };

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => showPreview(link.dataset.previewKey));
        link.addEventListener('focus', () => showPreview(link.dataset.previewKey));
      });

      // Reset do default po wyjściu kursora z mega menu
      megaMenu.addEventListener('mouseleave', () => showPreview(defaultKey));
    });
  };

  initMegaMenu();
  // Re-init po nawigacji View Transitions
  document.addEventListener('astro:page-load', initMegaMenu);
</script>
